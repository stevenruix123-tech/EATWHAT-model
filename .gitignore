# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行时产物（启动服务后生成，不应入库）----
app/artifacts/server.log
app/artifacts/server.pid

# 界面快照由 app/snapshot_ui.py 生成；保留 ui_shot.png（README 引用），
# 中间产物 ui_snapshot.html 不入库；_domdump.html 是 tooling/_dump_dom.py 的调试输出
app/artifacts/ui_snapshot.html
app/artifacts/_domdump.html

# ---- 容量扫描：只保留结论与逐轮明细，不重复存一份数据集 ----
# （那是一份和 app/artifacts 内容相同的数据集，共约 4 MB，
#   需要复现时在该目录跑 `python build_dataset.py` 即可重新生成）
app/capacity-study/artifacts/
app/capacity-study/__pycache__/

# ---- 实验产物（交接文档 §7.5）----
# 这些都是可重建的实验输出，不要进仓库：
#   artifacts_probe / artifacts_sweep*   : 配置扫描结果（JSON，小，但可重跑）
#   artifacts_torch*                     : PyTorch 训练产物，**线上模型不用这些**
#   artifacts_torch_pick 尤其不要进仓库（h96 候选，已被多 seed 复测推翻）
#   artifacts_v2 / artifacts_20k         : 放量实验数据集（20k 的效用矩阵约 66 MB）
#   artifacts_eval                       : 公共留出集（跨数据集比较用）
app/artifacts_probe/
app/artifacts_sweep*/
app/artifacts_torch*/
app/artifacts_v2/
app/artifacts_20k/
app/artifacts_eval/
app/artifacts_listwise*/
# artifacts_orig：从 git HEAD 还原的原始数据集，只用于「改前 vs 改后」的基线
app/artifacts_orig/

# ---- 临时/调试产物 ----
*.log
*.tmp
_log_*.txt
_live.png
